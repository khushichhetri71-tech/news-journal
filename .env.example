# Copy to .env.local and fill in.  ->  cp .env.example .env.local
# .env.local is gitignored — never commit real keys.

# ── Frontend (safe to expose; anon key is read-only via RLS) ──────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Analytics 4 measurement id (optional — analytics stays off if blank)
NEXT_PUBLIC_GA_ID=

# ── Nightly fetch script only ─────────────────────────────────────────────────
# In production these live in GitHub Actions secrets, NEVER in the frontend.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash   # optional; default is fine
